{
  "name": "@eodash/eodash",
  "version": "5.10.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "types": "./dist/types/core/client/types.d.ts",
  "files": [
    "core/client",
    "templates",
    "widgets",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eodash/eodash.git"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/core/client/types.d.ts"
      ],
      "webcomponent": [
        "./dist/types/core/client/asWebComponent.d.ts"
      ],
      "config": [
        "./dist/node/types.d.ts"
      ],
      "templates": [
        "./dist/types/templates/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/core/client/types.d.ts",
      "default": "./core/client/main.js"
    },
    "./webcomponent": {
      "types": "./dist/types/core/client/asWebComponent.d.ts",
      "default": "./dist/client/eo-dash.js"
    },
    "./templates": {
      "types": "./dist/types/templates/index.d.ts",
      "default": "./dist/client/templates.js"
    },
    "./config": {
      "types": "./dist/node/types.d.ts",
      "default": "./dist/node/main.js"
    }
  },
  "browser": "./core/client/main.js",
  "scripts": {
    "start": "npx eodash dev --entryPoint templates/baseConfig.js",
    "prepare": "rolldown -c && chmod +x dist/node/cli.js",
    "prepack": "npm run build:lib && npm run build:types",
    "dev": "npx eodash dev --entryPoint templates/baseConfig.js",
    "dev:lib": "npx eodash dev --entryPoint templates/baseConfig.js --lib",
    "build": "npx eodash build --entryPoint templates/baseConfig.js",
    "build:lib": "npx eodash build --entryPoint false --lib --outDir dist/client",
    "build:cli": "rolldown -c",
    "build:types": "vue-tsc --declaration  --emitDeclarationOnly && tsc-alias",
    "check": "vue-tsc --noEmit --skipLibCheck && eslint .",
    "format": "prettier . --write --ignore-unknown",
    "preview": "npx eodash preview",
    "lint": "eslint . --fix",
    "vitest": "vitest --ui",
    "vitest:browser": "vitest --project browser --browser.headless=false",
    "test": "vitest run",
    "test:browser": "vitest --project browser",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:template": "vitest run tests/template",
    "test:cli": "vitest run --project cli",
    "docs:dev": "test -d docs/api || npm run docs:generate && vitepress dev docs --port 3333",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "npm run build:cli && npm run build:types && typedoc --options typedoc.config.json"
  },
  "dependencies": {
    "@eox/chart": "^1.2.0",
    "@eox/drawtools": "^1.6.0",
    "@eox/feedback": "^1.2.0",
    "@eox/geosearch": "^1.2.0",
    "@eox/itemfilter": "^1.17.5",
    "@eox/jsonform": "^1.12.2",
    "@eox/layercontrol": "^1.8.2",
    "@eox/layout": "^1.0.0",
    "@eox/map": "^2.7.2",
    "@eox/stacinfo": "^1.2.0",
    "@eox/timecontrol": "^2.6.0",
    "@eox/ui": "^1.1.0",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "animated-details": "gist:2912bb049fa906671807415eb0e87188",
    "axios": "^1.19.0",
    "axios-cache-interceptor": "^1.12.3",
    "color-legend-element": "^1.5.0",
    "commander": "^15.0.0",
    "hyparquet": "^1.27.1",
    "loglevel": "^1.9.2",
    "mustache": "^4.2.0",
    "pinia": "^4.0.2",
    "sass": "^1.102.0",
    "stac-js": "^0.4.3",
    "stac-ts": "^1.0.5",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.41",
    "vuetify": "^3.12.8",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@eox/eslint-config": "^2.2.0",
    "@eox/pages-theme-eox": "^1.9.0",
    "@pinia/testing": "^2.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.2",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/devtools-api": "^8.1.5",
    "pkg-pr-new": "^0.0.87",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.3",
    "terminate": "^2.8.0",
    "tsc-alias": "^1.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-vue": "^1.5.1",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "3.3.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "eodash": "./dist/node/cli.js"
  }
}
