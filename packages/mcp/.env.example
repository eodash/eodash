# Copy this file to .env or inject these variables into your container environment.

# HTTP port the MCP server listens on.
PORT=3001

# Bind host. Defaults to loopback (127.0.0.1). Set to 0.0.0.0 in Docker/Kubernetes.
HOST=127.0.0.1

# Comma-separated list of trusted CORS origins (e.g. "https://my-dashboard.eu,https://eodash.org").
# If unset, only local development origins (localhost, 127.0.0.1) are accepted.
ALLOWED_ORIGINS=


# Maximum concurrent HTTP/SSE connections allowed per client IP address.
MAX_CONNECTIONS_PER_IP=10

# Maximum global concurrent HTTP/SSE connections across all clients.
MAX_SSE_CONNECTIONS=50

# Idle connection timeout in milliseconds before long-lived streams are reaped.
IDLE_TIMEOUT_MS=120000


# Set to "true" to permit requests to loopback (localhost, 127.0.0.1) and private
# RFC 1918 networks. Useful for local development with mock catalogs.
# WARNING: Keep "false" in production to prevent SSRF vulnerabilities.
ALLOW_LOCAL_STAC_ENDPOINTS=false

# Custom User-Agent header used for all outbound STAC and schema HTTP requests.
EODASH_MCP_USER_AGENT=eodash-mcp/0.2.0 (+https://github.com/eodash/eodash)

# Skip warming up remote EODash schemas at startup (allows offline start for most tools).
# Default: false (enforces strict startup dependency on authoritative schemas).
SKIP_SCHEMA_PRELOAD=false


# Maximum link-traversal recursion depth when resolving STAC catalog hierarchies.
EODASH_MAX_TRAVERSAL_DEPTH=5

# Maximum number of child collections processed from a single catalog document.
EODASH_MAX_COLLECTIONS=100


# Pino structured logging level: fatal | error | warn | info | debug | trace | silent
# Defaults to "info" in production, "debug" in development, "silent" in test.
LOG_LEVEL=info

# Node environment: development | production | test
NODE_ENV=production
