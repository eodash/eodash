[
  {
    "id": "rasterform-branching-multi-asset",
    "title": "TiTiler Multi-Asset Branching RasterForm with keep_oneof_values: false",
    "category": "rasterform",
    "tags": [
      "branching",
      "oneof",
      "keep_oneof_values",
      "titiler",
      "jsonform",
      "multi-asset",
      "sentinel-2",
      "rasterform",
      "xyz"
    ],
    "description": "Multi-asset branching form allowing users to toggle between True Color (RGB) and NDVI layers with distinct slider ranges, enforcing 'keep_oneof_values: false' to prevent state pollution.",
    "targetContext": "Define inside STAC link as 'eodash:rasterform' object, or reference as URL string.",
    "code": {
      "legend": {
        "rangeProperty": "colormap_name",
        "domainProperties": ["min", "max"]
      },
      "jsonform": {
        "type": "object",
        "title": "Product Mode",
        "options": {
          "keep_oneof_values": false,
          "removeProperties": ["minmax"]
        },
        "oneOf": [
          {
            "title": "True Color (RGB)",
            "properties": {
              "assets": {
                "type": "string",
                "default": "visual",
                "options": {
                  "hidden": true
                }
              }
            }
          },
          {
            "title": "NDVI (Vegetation)",
            "properties": {
              "assets": {
                "type": "string",
                "default": "ndvi",
                "options": {
                  "hidden": true
                }
              },
              "colormap_name": {
                "title": "Color Ramp",
                "type": "string",
                "enum": ["viridis", "rdylgn", "spectral"],
                "default": "rdylgn"
              },
              "minmax": {
                "title": "NDVI Range",
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "format": "range",
                    "minimum": -0.5,
                    "default": 0,
                    "step": 0.05
                  },
                  "max": {
                    "type": "number",
                    "format": "range",
                    "maximum": 1,
                    "default": 0.8,
                    "step": 0.05
                  }
                },
                "format": "minmax"
              },
              "rescale": {
                "type": "string",
                "template": "{{minmax.min}},{{minmax.max}}",
                "watch": {
                  "minmax": "minmax"
                },
                "options": {
                  "hidden": true
                }
              }
            }
          }
        ]
      }
    }
  },
  {
    "id": "rasterform-titiler-rescale-colormap",
    "title": "TiTiler Dynamic Rescale & Colormap RasterForm with RemoveProperties",
    "category": "rasterform",
    "tags": [
      "titiler",
      "rasterform",
      "rescale",
      "colormap",
      "xyz",
      "removeproperties",
      "template-watch",
      "legend-rangeproperty",
      "raster"
    ],
    "description": "eodash:rasterform configuration for TiTiler XYZ tile layer. Uses 'removeProperties: [\"minmax\"]' and template/watch to generate rescale URL parameter without polluting queries.",
    "targetContext": "Define inside STAC link as 'eodash:rasterform' object, or reference as URL string.",
    "code": {
      "legend": {
        "rangeProperty": "colormap_name",
        "domainProperties": ["min", "max"]
      },
      "jsonform": {
        "type": "object",
        "title": "Tile Display Settings",
        "options": {
          "removeProperties": ["minmax"]
        },
        "properties": {
          "colormap_name": {
            "title": "Colormap",
            "type": "string",
            "enum": [
              "viridis",
              "magma",
              "plasma",
              "inferno",
              "cividis",
              "rainbow",
              "spectral"
            ],
            "default": "viridis"
          },
          "minmax": {
            "title": "Value Range",
            "type": "object",
            "properties": {
              "min": {
                "type": "number",
                "format": "range",
                "minimum": 0,
                "default": 0
              },
              "max": {
                "type": "number",
                "format": "range",
                "maximum": 5000,
                "default": 3000
              }
            },
            "format": "minmax"
          },
          "rescale": {
            "type": "string",
            "template": "{{minmax.min}},{{minmax.max}}",
            "watch": {
              "minmax": "minmax"
            },
            "options": {
              "hidden": true
            }
          }
        }
      }
    }
  }
]
